# Music bot settings (copy to .env; real environment variables override this file).
# Run: cargo run -p rustlink-discord-bot --example music

# Required: Bot token from Discord Developer Portal -> Bot -> Reset Token.
# Auto-enables bare-link playback when Message Content Intent is on, and falls back on 4014.
DISCORD_BOT_TOKEN=

# Required: Matches `password` in the Rustlink node config.yaml.
RUSTLINK_PASSWORD=

# Rustlink node endpoint.
RUSTLINK_URL=http://127.0.0.1:2333

# Optional YouTube Proof-of-Origin token + visitorData (pushed live to the node on bot startup):
# RUSTLINK_YOUTUBE_PO_TOKEN=
# RUSTLINK_YOUTUBE_VISITOR_DATA=

# Optional limits and defaults:
# DISCORD_GUILD_IDS=123456789012345678,234567890123456789
# BOT_DEFAULT_VOLUME=100
# BOT_MAX_QUEUE=100
# BOT_IDLE_LEAVE_SECONDS=120
