# Settings for the music bot example (crates/discord-bot/examples/music).
#
#   1. Copy this file to .env        (.env is ignored by git; never commit it)
#   2. Fill in the two required values
#   3. cargo run -p rustlink-discord-bot --example music
#
# A real environment variable overrides the same name in this file.
# Another file can be named on the command line:  ... --example music -- other.env

# --- Required ---------------------------------------------------------------

# The bot token from the Discord Developer Portal (Bot -> Reset Token).
# Connects via `Gateway::connect_with_messages`: enables bare-link auto-play when
# Message Content Intent is turned on in the Developer Portal, and automatically
# falls back to unprivileged intents (4014) so `/play` and `@Bot <link>` always work.
DISCORD_BOT_TOKEN=

# The password in the Rustlink node's config.yaml (`password:`).
RUSTLINK_PASSWORD=

# --- Rustlink ---------------------------------------------------------------

# Where the Rustlink node listens.
RUSTLINK_URL=http://127.0.0.1:2333

# --- Optional ---------------------------------------------------------------

# Register the commands only in these servers (comma separated server IDs).
# Empty means every server the bot is in.
# DISCORD_GUILD_IDS=123456789012345678,234567890123456789

# Starting volume of each server, 0 to 200 (100 is the original volume).
# BOT_DEFAULT_VOLUME=100

# Most songs waiting in one server's queue, 1 to 1000.
# BOT_MAX_QUEUE=100

# Leave the voice channel after this many seconds with nothing to play.
# 0 stays until /stop.
# BOT_IDLE_LEAVE_SECONDS=120
