# Rustlink Discord audio node systemd unit (installed by install.sh).
[Unit]
Description=Rustlink Discord audio service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rustlink
Group=rustlink
WorkingDirectory=/opt/rustlink
ExecStart=/opt/rustlink/rustlink --config /opt/rustlink/config.yaml
Restart=on-failure
RestartSec=5
SyslogIdentifier=rustlink
OOMScoreAdjust=-200
Environment=MALLOC_ARENA_MAX=2
Environment=RUSTLINK_LOG_DIRECTORY=
LimitNOFILE=65535
KillSignal=SIGTERM
TimeoutStopSec=20
#MemoryMax=90%

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/opt/rustlink

[Install]
WantedBy=multi-user.target
